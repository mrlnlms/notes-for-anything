{
  "name": "notes-for-anything",
  "version": "0.2.0",
  "description": "Pair any file (PDF, image, audio, video) with a sidecar markdown note opened as a native Obsidian markdown view.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "author": "Marlon Lemes",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.17",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/ui": "^4.1.5",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "jsdom": "^29.1.0",
    "obsidian": "^1.12.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.5"
  }
}
